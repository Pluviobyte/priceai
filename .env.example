DATABASE_URL=postgresql://price_radar:price_radar@127.0.0.1:5433/price_radar
# Production: use distinct least-privilege roles provisioned by deploy/database-roles.sql.
WORKER_DATABASE_URL=
BROWSER_DATABASE_URL=
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=4
BROWSER_WORKER_CONCURRENCY=1
SCHEDULER_INTERVAL_MS=30000
# Optional system Chromium path; omit to use Playwright-managed Chromium.
BROWSER_EXECUTABLE_PATH=
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=price-radar-snapshots
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=minio-secret
PUBLIC_BASE_URL=http://localhost:3000
# Temporary header logo rollout. Set to classic to restore the previous metallic cube without reverting code.
NEXT_PUBLIC_HEADER_LOGO_VARIANT=ice
# Ice cube core rollout. Set to solid to restore the fixed blue core while keeping the ice shell.
NEXT_PUBLIC_ICE_CORE_VARIANT=flame
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-at-least-12-characters
# Preferred multi-user RBAC. In production entries must use passwordHash from scripts/hash-admin-password.mjs.
ADMIN_USERS_JSON=
FORM_FINGERPRINT_SECRET=replace-with-an-independent-32-character-secret
# Development only: enable when a local proxy resolves public hosts into its synthetic DNS ranges.
ALLOW_LOCAL_SYNTHETIC_DNS=false
# Signed HTTP endpoint that turns outbox payloads into email or other notifications.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Optional source discovery. Discovered URLs are candidates only and never price facts.
XAI_API_KEY=
BRAVE_SEARCH_API_KEY=
SOURCE_DISCOVERY_QUERY=AI subscription card shop ChatGPT Plus Claude Pro 发卡
AGGREGATOR_FEED_URLS=
# Optional operator-only LLM attribute candidate extraction.
LLM_EXTRACTION_ENDPOINT=
LLM_EXTRACTION_API_KEY=
LLM_EXTRACTION_MODEL=
