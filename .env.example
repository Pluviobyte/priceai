DATABASE_URL=postgresql://price_radar:price_radar@127.0.0.1:5433/price_radar
# Production: use distinct least-privilege roles provisioned by deploy/database-roles.sql.
WORKER_DATABASE_URL=
BROWSER_DATABASE_URL=
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=4
BROWSER_WORKER_CONCURRENCY=1
SCHEDULER_INTERVAL_MS=30000
# Worker scheduler for official API and transit price channels (one hour).
PRICE_REFRESH_INTERVAL_MS=3600000
# Worker scheduler for the official subscription sweep across all Apple storefronts, Google and OpenAI country pages (one day).
OFFICIAL_SUBSCRIPTION_REFRESH_INTERVAL_MS=86400000
# Optional authenticated manual trigger; the dedicated Dokploy Worker owns the daily schedule.
# Set this secret only on the Web service if manual HTTP triggering is needed.
OFFICIAL_PRICE_REFRESH_SECRET=replace-with-an-independent-32-character-secret
# Optional system Chromium path; omit to use Playwright-managed Chromium.
BROWSER_EXECUTABLE_PATH=
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=price-radar-snapshots
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=minio-secret
PUBLIC_BASE_URL=http://localhost:3000
# Temporary header logo rollout. Set to classic to restore the previous metallic cube without reverting code.
NEXT_PUBLIC_HEADER_LOGO_VARIANT=ice
# Ice cube core rollout. Set to solid to restore the fixed blue core while keeping the ice shell.
NEXT_PUBLIC_ICE_CORE_VARIANT=flame
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-at-least-12-characters
# Preferred multi-user RBAC. In production entries must use passwordHash from scripts/hash-admin-password.mjs.
ADMIN_USERS_JSON=
FORM_FINGERPRINT_SECRET=replace-with-an-independent-32-character-secret
# Development only: enable when a local proxy resolves public hosts into its synthetic DNS ranges.
ALLOW_LOCAL_SYNTHETIC_DNS=false
# Signed HTTP endpoint that turns outbox payloads into email or other notifications.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Source discovery and automatic merchant vetting. Discovered URLs are candidates only and never price facts;
# a candidate becomes an enabled source only after the automatic vetting (probe, identity, trial crawl,
# AI relevance, mirror/price checks) approves it. Set SOURCE_DISCOVERY_ENABLED=false to stop discovery and vetting.
SOURCE_DISCOVERY_ENABLED=true
# Public shop directories read for shop URLs (comma list; leave empty for all): priceai_merchants,aihaotan_shops,cardnav_shop_products,aibijia_products
SOURCE_DIRECTORY_PROVIDERS=
# How often directories and the 16688 source marketplace are re-read (one day).
SOURCE_DIRECTORY_IMPORT_INTERVAL_MS=86400000
# Candidates vetted per channel cycle; each costs one probe plus one trial crawl of the shop.
CANDIDATE_VETTING_BATCH=5
# Due sources crawled per channel cycle and pause between cycles.
CHANNEL_CRAWL_BATCH=20
CHANNEL_WORKER_TICK_MS=60000
# Source quality profiles are recomputed after this age (seven days).
QUALITY_PROFILE_MAX_AGE_MS=604800000
# Per-host pacing for every HTTP collector: minimum spacing, jitter and concurrent requests to one hostname.
COLLECTOR_HOST_MIN_INTERVAL_MS=700
COLLECTOR_HOST_JITTER_MS=300
COLLECTOR_HOST_MAX_CONCURRENCY=2
# Optional extra discovery channels.
XAI_API_KEY=
BRAVE_SEARCH_API_KEY=
SOURCE_DISCOVERY_QUERY=AI subscription card shop ChatGPT Plus Claude Pro 发卡
AGGREGATOR_FEED_URLS=
# Optional operator-only LLM attribute candidate extraction.
LLM_EXTRACTION_ENDPOINT=
LLM_EXTRACTION_API_KEY=
LLM_EXTRACTION_MODEL=

# Shared Shop API request policy (PostgreSQL; all workers on the same egress).
SHOP_API_PLATFORM_INTERVAL_MS=5000
SHOP_API_PLATFORM_DAILY_REQUESTS=3000
SHOP_API_PLATFORM_WAF_THRESHOLD=3
SHOP_API_PLATFORM_COOLDOWN_MS=86400000

# Host-routed collector egress. Set endpoint/token together; leave hosts empty to disable.
COLLECTOR_CN_HOSTS=
COLLECTOR_CN_ENDPOINT=
COLLECTOR_CN_TOKEN=
LDXP_DAILY_CANDIDATES=30
# Opt-in recovery of prior automatic WAF/non-relevant decisions after verified deployment.
COLLECTOR_GROWTH_RECOVERY=false
