FROM node:24-bookworm-slim AS worker
WORKDIR /app
ENV NODE_ENV=production PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY . .
RUN apt-get update && apt-get install -y --no-install-recommends tini && rm -rf /var/lib/apt/lists/*
RUN npm ci --include=dev && npx playwright install --with-deps chromium && chmod -R a+rX /ms-playwright
USER node
# Both worker entrypoints (official subscriptions, channel worker) refresh /tmp/worker-heartbeat every 30 seconds.
HEALTHCHECK --interval=60s --timeout=5s --start-period=90s CMD node -e "const fs=require('fs');const read=f=>{try{return Number(fs.readFileSync(f,'utf8'))}catch{return 0}};process.exit(Date.now()-Math.max(read('/tmp/worker-heartbeat'),read('/tmp/official-worker-heartbeat'),read('/tmp/channel-worker-heartbeat'))<120000?0:1)"
ENTRYPOINT ["/usr/bin/tini", "-g", "--"]
CMD ["node", "--import", "tsx", "apps/worker/src/official-subscriptions.ts"]

# Dokploy can select this build stage directly; no command override is required.
FROM worker AS channels
CMD ["node", "--import", "tsx", "apps/worker/src/channel-worker.ts"]

# Keep the default image compatible with the existing Official Worker application.
FROM worker AS official
